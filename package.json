{
  "name": "runrail",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "A local-first, verification-first harness for coding agents.",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "harness",
    "nifra",
    "verification"
  ],
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/TechDev009/runrail#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechDev009/runrail.git"
  },
  "bugs": {
    "url": "https://github.com/TechDev009/runrail/issues"
  },
  "files": [
    "src",
    "scripts/package-check.ts",
    "scripts/source-boundary-check.ts",
    "examples/external-harness-adapter",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./auth-vendors": "./src/auth-vendors.ts",
    "./cli": "./src/cli.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "runrail": "./src/cli.ts"
  },
  "scripts": {
    "package:check": "bun run scripts/package-check.ts",
    "source:check": "bun run scripts/source-boundary-check.ts",
    "prepack": "bun run package:check && bun run source:check",
    "test": "bun test",
    "test:isolated": "bun run scripts/test-isolated.ts",
    "typecheck": "tsc --noEmit",
    "test:packed": "bun run scripts/packed-consumer.ts"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.288"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "dependencies": {
    "@nifrajs/agent": "5.8.0",
    "@nifrajs/agent-protocol": "5.8.0",
    "@nifrajs/coding-agent": "5.8.0",
    "@nifrajs/mcp": "5.8.0",
    "@nifrajs/pi": "5.8.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.0"
  }
}
