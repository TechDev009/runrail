# Optional verification executable. Defaults to `nifra`.
RUNRAIL_NIFRA_COMMAND=nifra

# Optional Pi-compatible executable. Defaults to `pi`.
RUNRAIL_PI_COMMAND=pi

# Optional first-party provider credential environment names.
# Values are never read into Runrail evidence or logs.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

# Optional caller-owned service connector credential names. Keep values empty in
# this example and resolve them transiently; never copy secrets into Runrail.
GITHUB_TOKEN=
LINEAR_API_KEY=
JIRA_API_TOKEN=
SLACK_BOT_TOKEN=

# Optional packed-artifact directory. Defaults to /tmp/nifra-runrail-pack.
NIFRA_PACK_DIR=/tmp/nifra-runrail-pack